# DetectKB — Docker Compose settings (copy to .env, or let ./install.sh generate it)

# ── Web ──────────────────────────────────────────────────────────────────────
HTTP_PORT=80              # host port for the web UI
HTTP_BIND=0.0.0.0         # set to 127.0.0.1 when running behind another reverse proxy

# ── MySQL ────────────────────────────────────────────────────────────────────
# Use URL-safe characters only: MYSQL_PASSWORD is embedded in DATABASE_URL.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=detectkb
MYSQL_USER=detectkb
MYSQL_PASSWORD=change-me
MYSQL_PORT=3306           # only published by docker-compose.dev.yml

# ── Backend ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# 32+ random characters, e.g. `openssl rand -hex 32`. If left like this, production generates one
# and keeps it in backups/.secrets/jwt-secret.
JWT_SECRET=change-me-to-a-long-random-string

# Initial admin account — only used when the database has no users yet
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@detectkb.local

# Online lookups — set to false on servers without internet access
REFERENCE_AUTO_FETCH=true # LOLBAS / GTFOBins / LOLDrivers and analytic story details on first start
D3FEND_FETCH=true         # D3FEND countermeasures when a technique is opened
