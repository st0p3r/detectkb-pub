# Backend settings for running `npm run dev` directly on the host (no Docker).
# Copy to backend/.env. MySQL can be started with:
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d mysql
DATABASE_URL=mysql://detectkb:detectkb@localhost:3306/detectkb
PORT=3001
NODE_ENV=development
JWT_SECRET=your-secret-key-change-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=detectkb
BACKUP_DIR=../backups
# CORS_ORIGIN=http://localhost:5173
