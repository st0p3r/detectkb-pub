generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int            @id @default(autoincrement())
  username           String         @unique @db.VarChar(120)
  email              String         @unique @db.VarChar(255)
  passwordHash       String         @db.VarChar(255)
  firstName          String?        @db.VarChar(100)
  lastName           String?        @db.VarChar(100)
  isActive           Boolean        @default(true)
  mustChangePassword Boolean        @default(false)
  userRoles          UserRole[]
  auditLogs          AuditLog[]
  generatedDocs      GeneratedDoc[]
  savedViews         SavedView[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
}

model Role {
  id           Int              @id @default(autoincrement())
  name         String           @unique @db.VarChar(50)
  description  String?          @db.Text
  isSystemRole Boolean          @default(true)
  userRoles    UserRole[]
  permissions  RolePermission[]
  createdAt    DateTime         @default(now())
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique @db.VarChar(100)
  description String?          @db.Text
  category    String?          @db.VarChar(50)
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
}

model UserRole {
  id         Int      @id @default(autoincrement())
  userId     Int
  roleId     Int
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           Int        @id @default(autoincrement())
  roleId       Int
  permissionId Int
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model AuditLog {
  id           Int      @id @default(autoincrement())
  userId       Int?
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String   @db.VarChar(100)
  resourceType String   @db.VarChar(50)
  resourceId   Int?
  oldValue     Json?
  newValue     Json?
  ipAddress    String?  @db.VarChar(45)
  timestamp    DateTime @default(now())

  @@index([timestamp])
  @@index([userId])
}

model GeneratedDoc {
  id             Int      @id @default(autoincrement())
  title          String   @db.VarChar(255)
  format         String   @db.VarChar(10)
  filePath       String   @db.VarChar(500)
  fileSize       Int?
  contentSources Json?
  isPublic       Boolean  @default(false)
  generatedById  Int?
  generatedBy    User?    @relation(fields: [generatedById], references: [id], onDelete: SetNull)
  generatedAt    DateTime @default(now())
}

model Page {
  id           Int               @id @default(autoincrement())
  title        String            @db.VarChar(255)
  slug         String            @unique @db.VarChar(255)
  contentMd    String            @db.LongText
  type         String            @default("NOTE") @db.VarChar(80)
  categoryId   Int?
  category     Category?         @relation(fields: [categoryId], references: [id])
  tags         TagsOnPages[]
  outLinks     PageLink[]        @relation("source")
  inLinks      PageLink[]        @relation("target")
  revisions    Revision[]
  rule         DetectionRule?
  splCommand   SplCommand?
  sysmonEvents PageSysmonEvent[]
  logEvents    PageLogEvent[]
  stories      RuleStory[]
  isPinned     Boolean           @default(false)
  createdById  Int?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([type, updatedAt])
  @@index([updatedAt])
  @@index([title])
}

model PageTypeDefinition {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(80)
  label     String   @db.VarChar(80)
  color     String   @default("#6366f1") @db.VarChar(7)
  isBuiltIn Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PageLink {
  id       Int  @id @default(autoincrement())
  sourceId Int
  targetId Int
  source   Page @relation("source", fields: [sourceId], references: [id], onDelete: Cascade)
  target   Page @relation("target", fields: [targetId], references: [id], onDelete: Cascade)

  @@unique([sourceId, targetId])
}

model Category {
  id       Int        @id @default(autoincrement())
  name     String     @unique @db.VarChar(120)
  color    String?    @db.VarChar(20)
  parentId Int?
  parent   Category?  @relation("tree", fields: [parentId], references: [id])
  children Category[] @relation("tree")
  pages    Page[]
}

model Tag {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(80)
  color       String        @default("#3B82F6") @db.VarChar(7)
  description String?       @db.VarChar(500)
  category    String?       @db.VarChar(50)
  pages       TagsOnPages[]
}

model TagsOnPages {
  pageId Int
  tagId  Int
  page   Page @relation(fields: [pageId], references: [id], onDelete: Cascade)
  tag    Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([pageId, tagId])
}

model Revision {
  id        Int      @id @default(autoincrement())
  pageId    Int
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  contentMd String   @db.LongText
  title     String   @db.VarChar(255)
  createdAt DateTime @default(now())
}

model DetectionRule {
  id              Int     @id @default(autoincrement())
  pageId          Int     @unique
  page            Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  status          String  @db.VarChar(40)
  severity        String  @db.VarChar(20)
  splQuery        String  @db.LongText
  mitreTactics    String? @db.Text
  mitreTechniques String? @db.Text
  dataSource      String? @db.VarChar(255)
  falsePositives  String? @db.Text
  references      String? @db.Text
  testNotes       String? @db.LongText
  sigmaId         String? @db.VarChar(64)
  sigmaYaml       String? @db.LongText
  // Where the rule came from: sigma | escu (Splunk) | elastic | sentinel (null = written here)
  sourceFormat    String? @db.VarChar(20)
  sourceId        String? @db.VarChar(128)
  sourceContent   String? @db.LongText
  // Query in a non-SPL language (KQL, EQL, ES|QL, KQL-kuery, Lucene) from the source rule
  nativeQuery     String? @db.LongText
  nativeLanguage  String? @db.VarChar(20)

  // Not @unique: adding a unique constraint would need --accept-data-loss on
  // upgrade. Uniqueness is enforced in routes/rules.ts and routes/sigma.ts.
  @@index([sigmaId])
  @@index([sourceFormat, sourceId])
  // Filters and sorts of the rule list (GET /api/rules?page=…)
  @@index([status])
  @@index([severity])
}

model SplCommand {
  id          Int     @id @default(autoincrement())
  pageId      Int     @unique
  page        Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  command     String  @db.VarChar(120)
  group       String  @db.VarChar(80)
  syntax      String  @db.Text
  description String  @db.Text
  examples    String  @db.LongText
  pitfalls    String? @db.Text
  isFavorite  Boolean @default(false)
}

model BackupLog {
  id        Int      @id @default(autoincrement())
  fileName  String   @db.VarChar(255)
  sizeBytes Int
  type      String   @db.VarChar(20)
  createdAt DateTime @default(now())
}

model SysmonEvent {
  id             Int               @id @default(autoincrement())
  eventId        Int               @unique
  name           String            @db.VarChar(120)
  category       String            @db.VarChar(80)
  description    String            @db.Text
  keyFields      String?           @db.LongText
  detectionTips  String?           @db.LongText
  attackPatterns String?           @db.Text
  detectionValue String            @default("medium") @db.VarChar(20)
  isBuiltIn      Boolean           @default(true)
  createdAt      DateTime          @default(now())
  pages          PageSysmonEvent[]
}

// Which Sysmon events a page (detection rule, data source, ...) depends on.
// source = "auto" (inferred from the SPL / Sigma logsource) or "manual".
model PageSysmonEvent {
  pageId        Int
  sysmonEventId Int
  source        String      @default("manual") @db.VarChar(10)
  page          Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  sysmonEvent   SysmonEvent @relation(fields: [sysmonEventId], references: [id], onDelete: Cascade)

  @@id([pageId, sysmonEventId])
  @@index([sysmonEventId])
}

// Telemetry other than Sysmon for Windows (lib/log-events.ts): Windows event
// logs, PowerShell, auditd, EDR, cloud logs. key = "source:code", e.g.
// "windows-security:4688"; code "*" = any event of the source.
model LogEvent {
  id          Int            @id @default(autoincrement())
  key         String         @unique @db.VarChar(191)
  source      String         @db.VarChar(60)
  sourceLabel String         @db.VarChar(120)
  code        String         @db.VarChar(120)
  name        String         @db.VarChar(255)
  createdAt   DateTime       @default(now())
  pages       PageLogEvent[]

  @@index([source])
}

// Which log events a page (detection rule, data source) depends on.
// source = "auto" (from the rule's data sources / logsource / tables).
model PageLogEvent {
  pageId     Int
  logEventId Int
  source     String   @default("auto") @db.VarChar(10)
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  logEvent   LogEvent @relation(fields: [logEventId], references: [id], onDelete: Cascade)

  @@id([pageId, logEventId])
  @@index([logEventId])
}

// Splunk analytic stories: scenarios grouping ESCU detections. Rules link to
// them by the story names in their analytic_story tags; the description and
// narrative come from the story files (uploaded or fetched from GitHub).
model AnalyticStory {
  id          Int         @id @default(autoincrement())
  name        String      @unique @db.VarChar(191)
  externalId  String?     @db.VarChar(64)
  description String?     @db.Text
  narrative   String?     @db.LongText
  references  Json?
  category    String?     @db.VarChar(191)
  usecase     String?     @db.VarChar(120)
  detailsFrom String?     @db.VarChar(500)
  updatedAt   DateTime    @updatedAt
  rules       RuleStory[]
}

model RuleStory {
  pageId  Int
  storyId Int
  page    Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  story   AnalyticStory @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@id([pageId, storyId])
  @@index([storyId])
}

// D3FEND countermeasures per ATT&CK technique, cached from d3fend.mitre.org
model D3fendMapping {
  techniqueId String   @id @db.VarChar(20)
  data        Json
  fetchedAt   DateTime @default(now())
}

// Attacker-tool references (LOLBAS, GTFOBins, LOLDrivers). Fetched at runtime
// from the projects' official APIs — not bundled (LOLBAS/GTFOBins are GPL-3.0).
model ReferenceEntry {
  id        Int      @id @default(autoincrement())
  kind      String   @db.VarChar(20)
  key       String   @db.VarChar(191)
  name      String   @db.VarChar(255)
  data      Json
  updatedAt DateTime @updatedAt

  @@unique([kind, key])
}

model ReferenceDataset {
  kind      String   @id @db.VarChar(20)
  source    String   @db.VarChar(500)
  count     Int
  fetchedAt DateTime @default(now())
}

// A user's saved list view: filters, sort and view state of /rules, /pages or
// /graph, as the URL query string. Shown in the sidebar.
model SavedView {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String   @db.VarChar(80)
  path      String   @db.VarChar(40)
  query     String   @db.VarChar(1000)
  createdAt DateTime @default(now())

  @@index([userId])
}
